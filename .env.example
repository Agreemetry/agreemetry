# Shared-server mode. Leave both empty to build the local-workspace version.
# The anon (publishable) key is designed to be public; row-level security and the functions in
# supabase/migrations protect the data. Never put the service-role key here or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, shared server only. Everything here ends up in the public JavaScript bundle.
# Identity providers enabled in Supabase Auth, offered next to the email link, for example: github,google
VITE_AUTH_PROVIDERS=
# Terms of use and privacy notice of this deployment, linked at registration (see docs/HOSTING.md).
VITE_TERMS_URL=
VITE_PRIVACY_URL=
# Who runs this deployment, shown at registration.
VITE_OPERATOR_NAME=
